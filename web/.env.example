# web/ のビルド・開発サーバーに必要な環境変数の見本です。
# ローカルでは、このファイルを .env.local にコピーして値を埋めてください(.env.local は Git に入りません)。
#   cp .env.example .env.local
#
# NEXT_PUBLIC_* は `next build` のときに JS へ埋め込まれ、ブラウザから見える値です。秘密情報は書かないでください。
# Amplify Hosting では CDK(infra/lib/constructs/web-hosting.ts)がブランチの環境変数に自動で入れるため、手作業は不要です。

# API Gateway のベースURL(末尾スラッシュなし)。
# 値: CloudFormation スタック MobileOrder-<stage>-App の出力 HttpApiUrl
NEXT_PUBLIC_API_BASE_URL=

# 店員ログイン(Cognito)のアプリクライアントID。
# 値: CloudFormation スタック MobileOrder-<stage>-Stateful の出力 StaffUserPoolClientId
NEXT_PUBLIC_STAFF_CLIENT_ID=
